# All optional. Everything can also be set from the console (Settings / Live lab).
PORT=4000
HOST=127.0.0.1
# Public HTTPS URL of a tunnel to this server (e.g. `cloudflared tunnel --url http://localhost:4000`),
# used to show the webhook URL you paste into Meta for live Cloud API numbers.
PUBLIC_BASE_URL=
# Enables Claude-powered digests / Q&A. Without it the agent uses a labelled offline engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Ravi (the supplier assistant) answers on a faster model than the rest; change it here.
RAVI_MODEL=claude-haiku-5-5
# Sarvam (https://dashboard.sarvam.ai): speech-to-text and text-to-speech in Telugu, Hindi and English.
# With a key, voice notes and voice replies go through Sarvam instead of this Mac's Whisper and voices.
SARVAM_API_KEY=
# EquipXchange app bridge (optional). The app is the system of record; Switchboard carries WhatsApp.
# The secret is shared with SWITCHBOARD_SECRET in the app's apps/api/.env (at least 32 characters).
EQX_API_URL=
EQX_BRIDGE_SECRET=
# Cloud API channel the app's messages go out on (default: the sandbox number).
EQX_CHANNEL_ID=
# The app's web address, for the console's "decide in EquipXchange" link (default http://localhost:8081).
EQX_WEB_URL=
